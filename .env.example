# Copier en .env.local (jamais commité) et remplir les vraies valeurs.

# Chaîne de connexion Neon Postgres (Vercel > Storage > ton projet Neon
# > .env.local tab, ou dashboard.neon.tech > Connection Details).
DATABASE_URL=

# Pas de mot de passe partagé ici : le compte admin (email + mot de passe
# haché) vit dans la base, créé via `npm run db:seed-admin -- ton@email.com`
# une fois DATABASE_URL renseigné et la migration appliquée
# (`npm run db:migrate`).

# Cloudinary (upload d'images depuis le dashboard admin)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend (envoi des emails d'invitation admin + codes OTP) — clé API depuis
# resend.com > API Keys.
RESEND_API_KEY=
# Tant qu'aucun domaine n'est vérifié sur Resend, laisser la valeur par
# défaut (onboarding@resend.dev) — voir lib/email.ts.
RESEND_FROM_EMAIL=
